#!/bin/bash
# Remove any existing allowBuilds block from pnpm-workspace.yaml, then write
# the standard allowBuilds entries for this factory. Extra package names can
# be passed as arguments (e.g. setup-pnpm-builds yo @prisma/engines).
awk "BEGIN{skip=0} /^allowBuilds:/{skip=1;next} /^[^ ]/{skip=0} !skip{print}" \
    pnpm-workspace.yaml > /tmp/pw.tmp 2>/dev/null && \
    mv /tmp/pw.tmp pnpm-workspace.yaml 2>/dev/null || true

cat >> pnpm-workspace.yaml << 'YAML'
allowBuilds:
  esbuild: true
  sharp: true
  unrs-resolver: true
  "@swc/core": true
  core-js: true
  lightningcss: true
  "@tailwindcss/oxide": true
  "@parcel/watcher": true
  rollup: true
YAML

for pkg in "$@"; do
  printf '  "%s": true\n' "$pkg" >> pnpm-workspace.yaml
done
